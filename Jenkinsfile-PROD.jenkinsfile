pipeline {
    agent any

    tools {
        nodejs 'NodeJS23'
    }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch del repositorio a desplegar')
    }

    environment {
        S3_BUCKET = "tpintegrador-nehros"
        CLOUDFRONT_DISTRIBUTION_ID = "E38Z17P3Q94C7L" 
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Clonando repositorio desde la rama: ${params.BRANCH}"
                git url: 'https://github.com/alan25593/TPIntegrador-nehros.git', branch: "${params.BRANCH}", credentialsId: 'alan25593'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "Instalando dependencias de Node.js..."
                sh '''
                npm install
                '''
            }
        }

        stage('Build Project') {
            steps {
                echo "Construyendo el proyecto..."
                sh '''
                npm run build
                '''
            }
        }

        stage('Deploy to S3') {
            steps {
                echo "Subiendo los archivos construidos a S3..."
                sh '''
                aws s3 sync . s3://$S3_BUCKET --exclude ".git/*" --exclude "node_modules/*" --delete
                '''
            }
        }

        stage('Invalidate CloudFront Cache') {
            steps {
                echo "Invalidando la caché de CloudFront..."
                sh '''
                aws cloudfront create-invalidation --distribution-id $CLOUDFRONT_DISTRIBUTION_ID --paths "/*"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Despliegue exitoso en AWS S3 y CloudFront.'
        }
        failure {
            echo '❌ Error durante el despliegue en AWS.'
        }
        always {
            echo "🧹 Limpiando el workspace..."
            cleanWs()
        }
    }
}
