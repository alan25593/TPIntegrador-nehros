pipeline {
    agent any

    tools {
        nodejs 'NodeJS23'
    }

    environment {
        IMAGE_NAME = "nehros-test"
        CONTAINER_NAME = "nehros-test-container"
        DOCKER_PORT = "3000"
        NEXUS_REGISTRY = "172.31.15.248:5000"
        NEXUS_REPO = "alan-tp"
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/alan25593/TPIntegrador-nehros.git', branch: 'main', credentialsId: 'alan25593'
            }
        }

        stage('Install Dependencies and Build') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    sh '''
                    echo "Instalando dependencias..."
                    pnpm install
                    echo "Construyendo la aplicación..."
                    pnpm build
                    '''
                }
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                echo "Verificando contenido del workspace..."
                ls -la
                ls -la .next || echo "Directorio '.next' no encontrado"
                ls -la .next/static || echo "Directorio '.next/static' no encontrado"
                ls -la public || echo "Directorio 'public' no encontrado"
                '''
            }
        }

        stage('Create Docker Image') {
            steps {
                timeout(time: 5, unit: 'MINUTES') { 
                    script {
                        def dateTag = new Date().format('yyyyMMddHHmm', TimeZone.getTimeZone('America/Argentina/Buenos_Aires')) 
                        env.IMAGE_TAG = "${dateTag}" 

                        sh """
                        echo "Construyendo la imagen de Docker con tag de fecha..."
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        echo "Taggeando la imagen para Nexus..."
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${NEXUS_REGISTRY}/${NEXUS_REPO}/${IMAGE_NAME}:${IMAGE_TAG}
                        """
                    }
                }
            }
        }

        stage('Push Docker Image to Nexus') {
           steps {
                script {
                    echo "Iniciando sesión en Nexus Docker Registry..."
                    sh "docker push ${NEXUS_REGISTRY}/${NEXUS_REPO}/${IMAGE_NAME}:${IMAGE_TAG}"
                    echo "Imagen ${NEXUS_REGISTRY}/${NEXUS_REPO}/${IMAGE_NAME}:${IMAGE_TAG} subida a Nexus."
                }
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    def containerExists = sh(
                        script: "docker ps -a --format '{{.Names}}' | grep -w $CONTAINER_NAME || true",
                        returnStatus: true
                    ) == 0

                    if (containerExists) {
                        echo "El contenedor $CONTAINER_NAME ya existe. Deteniéndolo y eliminándolo..."
                        sh '''
                        docker stop $CONTAINER_NAME || true
                        docker rm $CONTAINER_NAME || true
                        '''
                    }

                    echo "Levantando un nuevo contenedor..."
                    sh '''
                    docker run -d --name $CONTAINER_NAME -p $DOCKER_PORT:3000 $IMAGE_NAME
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                echo "Verificando si el contenedor está corriendo..."
                docker ps | grep $CONTAINER_NAME || echo "El contenedor no está corriendo."
                echo "Verificando logs del contenedor..."
                docker logs $CONTAINER_NAME || echo "No se encontraron logs."
                echo "Verifica manualmente el acceso: http://<tu-servidor>:$DOCKER_PORT"
                '''
            }
        }
    }

    post {
        success {
            echo 'Despliegue en TEST completado exitosamente.'
        }
        failure {
            echo 'Hubo un error en el despliegue en TEST.'
        }
        always {
            echo 'Limpieza del workspace ejecutada.'
            cleanWs()
            script {
                echo "Eliminando imágenes Docker <none>..."
                sh "docker rmi \$(docker images -f 'dangling=true' -q) || true"
            }
        }
    }
}