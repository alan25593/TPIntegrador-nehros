pipeline {
    agent any

    tools {
        nodejs 'NodeJS23'
    }

    environment {
        IMAGE_NAME = "nehros-test"
        CONTAINER_NAME = "nehros-test-container"
        DOCKER_PORT = "80"
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/alan25593/TPIntegrador-nehros.git', branch: 'main', credentialsId: 'alan25593'
            }
        }

        stage('Build') {
            steps {
                sh '''
                pnpm install
                pnpm build
                '''
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                echo "Verificando contenido del workspace:"
                ls -la
                ls -la .next || echo "Directorio '.next' no encontrado"
                '''
            }
        }

        stage('Create Docker Image') {
            steps {
                sh '''
                docker build -t $IMAGE_NAME .
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    def containerExists = sh(
                        script: "docker ps -a --format '{{.Names}}' | grep -w $CONTAINER_NAME || true",
                        returnStatus: true
                    ) == 0
        
                    if (containerExists) {
                        echo "El contenedor $CONTAINER_NAME ya existe. Deteniéndolo y eliminándolo..."
                        sh '''
                        docker stop $CONTAINER_NAME
                        docker rm $CONTAINER_NAME
                        '''
                    } else {
                        echo "El contenedor $CONTAINER_NAME no existe. Levantando uno nuevo..."
                    }
        
                    sh '''
                    docker run -d --name $CONTAINER_NAME -p $DOCKER_PORT:80 $IMAGE_NAME
                    '''
                }
            }
        }

    }

    post {
        success {
            echo 'Despliegue en TEST completado exitosamente.'
            cleanWs()
        }
        failure {
            echo 'Hubo un error en el despliegue en TEST.'
            cleanWs()
        }
        always {
            echo 'Limpieza del workspace ejecutada.'
            cleanWs()
        }
    }
}
