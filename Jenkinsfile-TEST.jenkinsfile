pipeline {
    agent any

    tools {
        nodejs 'NodeJS23' // Tu instalación de Node.js en Jenkins
    }

    environment {
        IMAGE_NAME = "nextjs-app"
        CONTAINER_NAME = "nextjs-container"
        APP_PORT = "3000"
    }

    stages {
        stage('Checkout') {
            steps {
                // Clonar el repositorio
                git url: 'https://github.com/tu-usuario/tu-repositorio.git', branch: 'main', credentialsId: 'alan25593'
            }
        }

        stage('Build') {
            steps {
                // Construir el proyecto
                sh '''
                pnpm install
                pnpm build
                '''
            }
        }

        stage('Debug Workspace') {
            steps {
                // Verificar el contenido del workspace
                sh '''
                echo "Verificando contenido del workspace:"
                ls -la
                ls -la .next || echo "Directorio '.next' no encontrado"
                '''
            }
        }

        stage('Create Docker Image') {
            steps {
                // Crear la imagen Docker
                sh '''
                docker build -t $IMAGE_NAME .
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                script {
                    // Verificar si el contenedor existe y reiniciarlo si es necesario
                    def containerExists = sh(
                        script: "docker ps -a --format '{{.Names}}' | grep -w $CONTAINER_NAME || true",
                        returnStatus: true
                    ) == 0
        
                    if (containerExists) {
                        echo "El contenedor $CONTAINER_NAME ya existe. Deteniéndolo y eliminándolo..."
                        sh '''
                        docker stop $CONTAINER_NAME
                        docker rm $CONTAINER_NAME
                        '''
                    }
        
                    echo "Iniciando el contenedor $CONTAINER_NAME..."
                    sh '''
                    docker run -d --name $CONTAINER_NAME -p $APP_PORT:3000 $IMAGE_NAME
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Despliegue completado exitosamente.'
            cleanWs()
        }
        failure {
            echo 'Error durante el despliegue.'
            cleanWs()
        }
        always {
            echo 'Limpieza del workspace ejecutada.'
            cleanWs()
        }
    }
}
