pipeline {
    agent any

    tools {
        nodejs 'NodeJS23' 
    }

    environment {
        IMAGE_NAME = "nehros-test"
        CONTAINER_NAME = "nehros-test-container"
        DOCKER_PORT = "3000"
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/alan25593/TPIntegrador-nehros.git', branch: 'main', credentialsId: 'alan25593'
            }
        }

        stage('Build') {
            steps {
                sh '''
                pnpm install
                pnpm build
                pnpm export
                '''
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                echo "Verificando contenido del workspace:"
                ls -la
                ls -la out || echo "Directorio 'out' no encontrado"
                '''
            }
        }

        stage('Create Docker Image') {
            steps {
                sh '''
                DOCKER_BUILDKIT=1 docker build -t $IMAGE_NAME --build-arg BUILD_PATH=out .
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                docker stop $CONTAINER_NAME || true
                docker rm $CONTAINER_NAME || true
                docker run -d --name $CONTAINER_NAME -p $DOCKER_PORT:80 $IMAGE_NAME
                '''
            }
        }
    }

    post {
        success {
            echo 'Despliegue en TEST completado exitosamente.'
            cleanWorkspace()
        }
        failure {
            echo 'Hubo un error en el despliegue en TEST.'
            cleanWorkspace()
        }
        always {
            echo 'Limpieza del workspace ejecutada.'
            cleanWorkspace()
        }
    }
}
